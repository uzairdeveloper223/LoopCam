# python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# virtual environments (if you decide to test in one)
venv/
.venv/
env/

# debian build artifacts
# when you run dpkg-buildpackage, it creates a staging folder and logs inside debian/
debian/.debhelper/
debian/loopcam/
debian/files
debian/*.debhelper.log
debian/*.substvars
debian/*.postinst.debhelper
debian/*.postrm.debhelper
debian/*.prerm.debhelper

# compiled packages and source archives
# these usually generate in the parent directory, but we ignore them globally 
# so you never accidentally push a 50mb .deb file to your github repo
*.deb
*.changes
*.buildinfo
*.dsc
*.tar.gz
*.debian.tar.xz

# editor backups and os junk
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db